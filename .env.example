# SkillLens configuration. Copy to .env (or run `npm run setup`, which generates secrets for you).
# Never commit .env.

# --- API server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Leave empty to use the embedded PostgreSQL (PGlite) stored in server/.data/pglite (no install needed).
# Set to use a real PostgreSQL server, e.g. postgres://skilllens:password@localhost:5432/skilllens
DATABASE_URL=
# PGLITE_DATA_DIR=./server/.data/pglite

# --- Auth ---
# 32+ random characters. `npm run setup` generates one.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Accounts created on first start ---
# Admin accounts cannot self-register; this is the only way to create one.
ADMIN_EMAIL=admin@skilllens.local
ADMIN_PASSWORD=
ADMIN_NAME=Research Admin
# Optional demo student with a sample Data Scientist profile (leave password empty to skip)
DEMO_STUDENT_EMAIL=student@skilllens.local
DEMO_STUDENT_PASSWORD=

# --- Data ---
# Load the clearly-labelled synthetic demo dataset on first start
SEED_DEMO_DATA=true
